{% from "configuration/map.jinja" import configuration with context -%}
vm_library_path = {{ (configuration.home ~ "/Documents/VMs") | tojson }}
metadata_path = {{ (configuration.config_home ~ "/vm-curator/metadata") | tojson }}
ascii_art_path = {{ (configuration.config_home ~ "/vm-curator/ascii") | tojson }}
snapshot_prefix = "snapshot"
default_memory_mb = 4096
default_cpu_cores = 2
default_disk_size_gb = 64
default_display = "gtk"
default_enable_kvm = true
confirm_before_launch = true
enable_multi_gpu_passthrough = false
default_ivshmem_size_mb = 64
show_gpu_warnings = true
single_gpu_enabled = false
single_gpu_auto_tty = false
looking_glass_auto_launch = true
