{% from "configuration/map.jinja" import configuration with context %}
{
  "model": "opus",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 0
  },
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "agentPushNotifEnabled": true,
  "voiceEnabled": true,
  "useAutoModeDuringPlan": false,
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": {{ ("bash '" ~ configuration.home ~ "/.claude/hooks/herdr-agent-state.sh' session") | tojson }},
            "timeout": 10
          }
        ]
      }
    ]
  }
}
