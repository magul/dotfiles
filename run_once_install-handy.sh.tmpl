#!/bin/bash
# Install Handy (offline speech-to-text)
set -euo pipefail

{{ if eq .chezmoi.os "linux" -}}
if dpkg -s handy &>/dev/null; then
    echo "Handy is already installed: $(dpkg-query -W -f='${Version}' handy)"
    exit 0
fi

echo "Installing Handy..."

# Handy names its Debian packages Handy_X.Y.Z_amd64.deb / Handy_X.Y.Z_arm64.deb
ARCH=$(uname -m)
case "$ARCH" in
    x86_64) DEB_ARCH="amd64" ;;
    aarch64) DEB_ARCH="arm64" ;;
    *) echo "Error: Unsupported architecture: $ARCH" >&2; exit 1 ;;
esac

DOWNLOAD_URL=$(curl -fsSL https://api.github.com/repos/cjpais/Handy/releases/latest \
    | grep -o "\"browser_download_url\": *\"[^\"]*_${DEB_ARCH}\.deb\"" \
    | cut -d'"' -f4 \
    | head -1)

if [ -z "$DOWNLOAD_URL" ]; then
    echo "Error: Could not determine latest Handy .deb URL for ${DEB_ARCH}." >&2
    exit 1
fi

DEB_PATH=$(mktemp --suffix=.deb)
trap 'rm -f "$DEB_PATH"' EXIT
curl -fSL "$DOWNLOAD_URL" -o "$DEB_PATH"

# apt-get (not dpkg) so the WebKit/GTK runtime deps get pulled in too
sudo apt-get update
sudo apt-get install -y "$DEB_PATH"

{{ else if eq .chezmoi.os "darwin" -}}
if [ -d "/Applications/Handy.app" ]; then
    echo "Handy is already installed."
    exit 0
fi

echo "Installing Handy via Homebrew..."
{{ template "ensure-homebrew" . -}}
brew install --cask handy
{{ else -}}
echo "Unsupported OS: {{ .chezmoi.os }}" >&2
exit 1
{{ end -}}

echo "Handy installation complete."
