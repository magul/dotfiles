#!/bin/bash
# Install Obsidian
set -euo pipefail

{{ if eq .chezmoi.os "linux" -}}
echo "Obsidian on Debian/Ubuntu desktops is managed by Salt. See docs/salt.md."
{{ else if eq .chezmoi.os "darwin" -}}
if [ -d "/Applications/Obsidian.app" ]; then
    echo "Obsidian is already installed."
    exit 0
fi

echo "Installing Obsidian via Homebrew..."
{{ template "ensure-homebrew" . -}}
brew install --cask obsidian
{{ else -}}
echo "Unsupported OS: {{ .chezmoi.os }}" >&2
exit 1
{{ end -}}

echo "Obsidian installation complete."
