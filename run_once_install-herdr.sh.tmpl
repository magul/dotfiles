#!/bin/bash
# Install Herdr (terminal multiplexer for coding agents)
set -euo pipefail

if command -v herdr &>/dev/null; then
    echo "Herdr is already installed: $(herdr --version 2>/dev/null | head -1)"
    exit 0
fi

echo "Installing Herdr..."

{{ if eq .chezmoi.os "linux" -}}
# Official installer picks the right linux-{x86_64,aarch64} binary from the
# release manifest; ~/.local/bin is already on PATH via ~/.zprofile.
export HERDR_INSTALL_DIR="$HOME/.local/bin"
curl -fsSL https://herdr.dev/install.sh | sh
export PATH="$HERDR_INSTALL_DIR:$PATH"
{{ else if eq .chezmoi.os "darwin" -}}
{{ template "ensure-homebrew" . -}}
brew install herdr
{{ else -}}
echo "Unsupported OS: {{ .chezmoi.os }}" >&2
exit 1
{{ end -}}

echo "Herdr installed: $(herdr --version 2>/dev/null | head -1)"
