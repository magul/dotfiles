#!/bin/bash
# Install Visual Studio Code
set -euo pipefail

{{ if eq .chezmoi.os "linux" -}}
echo "VS Code installation on Debian/Ubuntu is managed by Salt. See docs/salt.md."
{{ else -}}
if command -v code &>/dev/null; then
    echo "VS Code is already installed."
    exit 0
fi

{{ if eq .chezmoi.os "darwin" -}}
echo "Installing VS Code via Homebrew..."
{{ template "ensure-homebrew" . -}}
brew install --cask visual-studio-code
{{ else -}}
echo "Unsupported OS: {{ .chezmoi.os }}" >&2
exit 1
{{ end -}}

echo "VS Code installation complete."
{{ end -}}
