#!/bin/bash
# Install Google Chrome
set -euo pipefail

{{ if eq .chezmoi.os "linux" -}}
echo "Google Chrome on Debian/Ubuntu desktops is managed by Salt. See docs/salt.md."
{{ else -}}
if command -v google-chrome &>/dev/null || command -v google-chrome-stable &>/dev/null || [ -d "/Applications/Google Chrome.app" ]; then
    echo "Google Chrome is already installed."
    exit 0
fi

{{ if eq .chezmoi.os "darwin" -}}
echo "Installing Google Chrome via Homebrew..."
{{ template "ensure-homebrew" . -}}
brew install --cask google-chrome
{{ else -}}
echo "Unsupported OS: {{ .chezmoi.os }}" >&2
exit 1
{{ end -}}

echo "Google Chrome installation complete."
{{ end -}}
