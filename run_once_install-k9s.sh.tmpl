#!/bin/bash
# Install k9s (Kubernetes CLI)
set -euo pipefail

{{ if eq .chezmoi.os "linux" -}}
echo "k9s on Debian/Ubuntu is managed by Salt. See docs/salt.md."
{{ else -}}

if command -v k9s &>/dev/null; then
    echo "k9s is already installed: $(k9s version --short)"
    exit 0
fi

echo "Installing k9s..."

{{ if eq .chezmoi.os "darwin" -}}
{{ template "ensure-homebrew" . -}}
brew install k9s
{{ else -}}
echo "Unsupported OS: {{ .chezmoi.os }}" >&2
exit 1
{{ end -}}

echo "k9s installed: $(k9s version --short)"
{{ end -}}
