#!/bin/bash
# Install Hunk (review-first terminal diff viewer)
set -euo pipefail

{{ if eq .chezmoi.os "linux" -}}
echo "Hunk on Debian/Ubuntu is managed by Salt. See docs/salt.md."
{{ else -}}
if command -v hunk &>/dev/null; then
    echo "Hunk is already installed: $(hunk --version 2>/dev/null | head -1)"
    exit 0
fi

echo "Installing Hunk..."

{{ if eq .chezmoi.os "darwin" -}}
{{ template "ensure-homebrew" . -}}
brew install hunk
{{ else -}}
echo "Unsupported OS: {{ .chezmoi.os }}" >&2
exit 1
{{ end -}}

echo "Hunk installed: $(hunk --version 2>/dev/null | head -1)"
{{ end -}}
