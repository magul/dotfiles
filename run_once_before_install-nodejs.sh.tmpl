{{ if or (eq .chezmoi.os "linux") (eq .chezmoi.os "darwin") -}}
#!/bin/bash
# Install per-user nvm and Node.js before npm-dependent installers.
set -euo pipefail

export NVM_DIR="$HOME/.nvm"
if [ ! -s "$NVM_DIR/nvm.sh" ]; then
    echo "Installing nvm..."
    # Our managed .zshrc already loads nvm; avoid installer edits to profiles.
    curl -fsSL https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.8/install.sh | PROFILE=/dev/null bash
fi

source "$NVM_DIR/nvm.sh" --no-use
if nvm use default >/dev/null 2>&1 && command -v npm &>/dev/null; then
    echo "Using existing default Node.js: $(node --version)"
else
    echo "Installing Node.js LTS..."
    nvm install --lts
    nvm alias default "$(nvm current)"
fi

echo "nvm: $(nvm --version), Node.js: $(node --version), npm: $(npm --version)"
{{ end -}}
