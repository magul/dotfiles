#!/bin/bash
# Install Neovim if not already installed
set -euo pipefail

{{ if eq .chezmoi.os "linux" -}}
# Debian/Ubuntu package installation is now owned by masterless Salt.
echo "Neovim installation on Debian/Ubuntu is managed by Salt. See docs/salt.md."
{{ else -}}
if command -v nvim &>/dev/null; then
    echo "Neovim is already installed: $(nvim --version | head -1)"
    exit 0
fi

echo "Installing Neovim..."
{{ if eq .chezmoi.os "darwin" -}}
{{ template "ensure-homebrew" . -}}
brew install neovim
{{ end -}}
echo "Neovim installed: $(nvim --version | head -1)"
{{ end -}}
