#!/bin/bash
# Install Helm (Kubernetes package manager)
set -euo pipefail

{{ if eq .chezmoi.os "linux" -}}
echo "Helm and helm-diff on Debian/Ubuntu are managed by Salt. See docs/salt.md."
{{ else -}}
if command -v helm &>/dev/null; then
    echo "Helm is already installed: $(helm version --short)"
    exit 0
fi

echo "Installing Helm..."

{{ if eq .chezmoi.os "darwin" -}}
{{ template "ensure-homebrew" . -}}
brew install helm
{{ else -}}
echo "Unsupported OS: {{ .chezmoi.os }}" >&2
exit 1
{{ end -}}

echo "Helm installed: $(helm version --short)"

# Install helm-diff plugin
if ! helm plugin list | grep -q '^diff'; then
    echo "Installing helm-diff plugin..."
    helm plugin install https://github.com/databus23/helm-diff --verify=false
    echo "helm-diff plugin installed."
else
    echo "helm-diff plugin is already installed."
fi
{{ end -}}
